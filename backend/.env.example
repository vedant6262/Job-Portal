SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@jobportal.com

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

